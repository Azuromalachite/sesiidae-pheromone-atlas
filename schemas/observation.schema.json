{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azuromalachite/sesiidae-pheromone-atlas/schemas/observation.schema.json",
  "title": "Observation",
  "description": "One measurement event, typed by what was measured (concept §13). Gland contents, male behaviour and antennal responses are different observations, never one record with a 'role' field.",
  "type": "object",
  "required": ["observation_id", "observation_type", "taxon", "context", "evidence"],
  "properties": {
    "observation_id": {"type": "string", "pattern": "^spa\\.obs\\.[a-z0-9_.]+$", "description": "spa.obs.<taxon>.<year>.<first author>.<what was measured>; permanent (docs/identifiers.md)"},
    "observation_type": {"enum": ["gland_composition", "behavioural_response", "electrophysiology"]},
    "taxon": {"type": "string"},
    "context": {"$ref": "#/$defs/context"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "source_location"],
      "properties": {
        "reference": {"type": "string"},
        "source_location": {"type": "string", "description": "where in the source this was read, e.g. 'abstract', 'Table 2'"},
        "author_statement": {"type": "string", "maxLength": 200, "description": "the authors' own short wording of the result, kept apart from the Atlas's reading"},
        "unresolved": {"type": "array", "items": {"type": "string"}, "description": "what this record needs and the source as read does not give: missing evidence, stated explicitly"},
        "notes": {"type": "string", "description": "the Atlas's notes and inferences, never the authors'"}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "observation_id": true, "observation_type": {"const": "gland_composition"},
        "taxon": true, "context": true, "evidence": true,
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}}
      },
      "required": ["components"],
      "additionalProperties": false
    },
    {
      "properties": {
        "observation_id": true, "observation_type": {"const": "behavioural_response"},
        "taxon": true, "context": true, "evidence": true,
        "assay": {"enum": ["field_trapping", "wind_tunnel", "other"]},
        "blend": {"$ref": "#/$defs/blend"},
        "trap": {"$ref": "#/$defs/trap"},
        "dispenser": {"$ref": "#/$defs/dispenser"},
        "comparator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": {"type": "string"},
            "blend": {"$ref": "#/$defs/blend"},
            "trap": {"$ref": "#/$defs/trap", "description": "only when the comparator's trap differs from the treatment's"},
            "dispenser": {"$ref": "#/$defs/dispenser", "description": "only when the comparator's dispenser differs from the treatment's"}
          }
        },
        "effect": {"enum": ["increased", "decreased", "no_effect", "caught_without_control"],
                   "description": "relative to the comparator; caught_without_control means males were caught and no comparator was run. With significance not_tested, effect is the direction of the raw means, so equal numbers always get the same label; the authors' own reading, if any, is in author_statement"},
        "significance": {"enum": ["significant", "not_significant", "not_tested", "not_reported"], "description": "not_tested: the paper ran no test on this contrast, e.g. a zero-catch treatment left out of the ANOVA"},
        "dose": {"$ref": "#/$defs/quantity", "description": "total load per lure, when given"},
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measure", "unit"],
          "description": "the size of the effect, when the source gives one",
          "properties": {
            "measure": {"enum": ["trap_catch", "close_range_approach", "landing", "other"]},
            "unit": {"enum": ["fold_change_vs_comparator", "percent_of_males", "count", "mean_catch_per_trap", "mean_catch_per_trap_per_week", "total_catch"]},
            "treatment_value": {"type": ["number", "null"]},
            "comparator_value": {"type": ["number", "null"]},
            "qualifier": {"enum": ["as_reported", "approximate", "more_than", "less_than"]}
          }
        }
      },
      "required": ["assay", "blend", "effect"],
      "allOf": [
        {
          "if": {"properties": {"effect": {"const": "caught_without_control"}}, "required": ["effect"]},
          "then": {"not": {"required": ["comparator"]}},
          "else": {"required": ["comparator"]}
        }
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "observation_id": true, "observation_type": {"const": "electrophysiology"},
        "taxon": true, "context": true, "evidence": true,
        "responses": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["compound", "method", "preparation", "response"],
            "properties": {
              "compound": {"type": "string"},
              "method": {"enum": ["EAG", "GC-EAD", "SSR"], "description": "SSR = single-sensillum recording"},
              "preparation": {"type": "string"},
              "response": {"enum": ["active", "inconsistent", "inactive", "not_tested"], "description": "inconsistent: the authors report responses in some recordings and not others"},
              "notes": {"type": "string"}
            }
          }
        }
      },
      "required": ["responses"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sex": {"enum": ["female", "male", null]},
        "tissue": {"type": ["string", "null"]},
        "life_stage": {"type": ["string", "null"]},
        "population": {"type": ["string", "null"]},
        "locality": {"type": ["string", "null"]},
        "habitat": {"type": ["string", "null"], "description": "as reported, e.g. 'black currant field'"},
        "rearing": {"enum": ["wild", "field_collected_reared", "laboratory", null], "description": "field_collected_reared: collected as larvae or pupae, adults emerged in the laboratory"},
        "mating_status": {"enum": ["virgin", "mated", null]},
        "behavioural_state": {"enum": ["calling", null]},
        "sampling_unit": {"enum": ["pooled", "individual", null], "description": "pooled extract or single insects; ratios can differ between the two"},
        "n_individuals": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compound", "detected"],
      "properties": {
        "compound": {"type": "string"},
        "detected": {"enum": [true, false, "not_tested"], "description": "not_tested is unknown; false is a negative and needs a method"},
        "method": {"type": "string", "description": "how presence or absence was established"},
        "identification": {"enum": ["confirmed", "tentative"], "description": "as the authors state it: tentative when they call it tentative (e.g. Yang 2011 for retention-index-only matches), confirmed when they present it as identified; method and notes say what it rests on, e.g. geometry from retention on one polar column"},
        "abundance_class": {"enum": ["major", "minor", "trace"]},
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "unit"],
            "properties": {
              "value": {"type": "number"},
              "unit": {"enum": ["relative_to_major", "percent", "ng_per_female", "ratio_part"]},
              "method": {"type": "string", "description": "overrides the component's method"},
              "qualifier": {"enum": ["as_reported", "approximate", "mean", "range_midpoint"]},
              "spread": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "kind"],
                "properties": {
                  "value": {"type": "number"},
                  "kind": {"enum": ["sd", "se"]}
                }
              }
            }
          }
        },
        "detection_limit": {"$ref": "#/$defs/quantity"}
      },
      "allOf": [
        {
          "if": {"properties": {"detected": {"enum": [true, false]}}},
          "then": {"required": ["method"]}
        },
        {
          "if": {"required": ["identification"]},
          "then": {"properties": {"detected": {"const": true}}}
        }
      ]
    },
    "blend": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["compound"],
        "properties": {
          "compound": {"type": "string"},
          "amount": {"$ref": "#/$defs/quantity"},
          "purity": {"$ref": "#/$defs/purity"}
        }
      }
    },
    "purity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind", "basis"],
      "description": "purity of the synthetic in the lure. Chemical and isomeric purity are different claims: a compound can be free of geometric isomers and still only 83 % pure",
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 100, "description": "percent"},
        "kind": {"enum": ["chemical", "isomeric", "chemical_and_isomeric", "unspecified"]},
        "basis": {"enum": ["measured", "stated"], "description": "measured by the authors, or stated by them or a supplier without data"},
        "qualifier": {"enum": ["as_reported", "more_than"]},
        "method": {"type": "string"}
      }
    },
    "dispenser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design"],
      "description": "what carries the lure; release rate depends on it as much as on the load",
      "properties": {
        "design": {"enum": ["rubber_septum", "rubber_sleeve_stopper", "rubber_tube", "polyethylene_vial", "other"]},
        "description": {"type": ["string", "null"], "description": "as given, e.g. 'red rubber sleeve stopper, 7 x 11 mm'"}
      }
    },
    "trap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design"],
      "properties": {
        "design": {"enum": ["delta", "bucket", "funnel", "bottle", "sticky_board", "wing", "other"], "description": "funnel includes the universal moth trap (Unitrap); bucket is a bucket trap as the authors name it"},
        "colour": {"type": ["string", "null"], "description": "as named by the authors"},
        "colour_lab": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L", "a", "b"],
          "description": "CIE L*a*b* of the trap surface, when measured",
          "properties": {
            "L": {"type": "number", "minimum": 0, "maximum": 100},
            "a": {"type": "number"},
            "b": {"type": "number"}
          }
        },
        "supplier": {"type": ["string", "null"]}
      }
    }
  }
}
