{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azuromalachite/sesiidae-pheromone-atlas/schemas/teaching-bundle.schema.json",
  "title": "Teaching bundle spa.teaching/0",
  "description": "What a teaching consumer (Arrowfield) may read about one case. Built from the Atlas records named in teaching/cases/<case_id>.yaml by scripts/export_teaching_bundle.py. Every statement and both sides of every observed_contrast are assembled from record fields, unrounded and with nothing left out; case_title and case_label are the only text not built from records, and are the case author's words. derived/teaching/<case_id>.json carries no atlas_version (derived/ holds no release metadata); a copy exported with --atlas-version carries the commit or tag it was built from.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle",
    "case_id",
    "case_title",
    "schema_version",
    "compounds",
    "observations",
    "comparisons",
    "espmap"
  ],
  "properties": {
    "bundle": {
      "const": "spa.teaching/0"
    },
    "case_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "description": "the Atlas record shape the bundle was built from"
    },
    "atlas_version": {
      "type": "string",
      "description": "commit or tag; only on exported copies"
    },
    "compounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atlas_id",
          "inchikey",
          "shorthand",
          "systematic",
          "occurrences",
          "evidence_classes"
        ],
        "properties": {
          "atlas_id": {
            "type": "string"
          },
          "inchikey": {
            "type": "string"
          },
          "shorthand": {
            "type": "string"
          },
          "systematic": {
            "type": [
              "string",
              "null"
            ]
          },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observation_id",
                "roles"
              ],
              "properties": {
                "observation_id": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "treatment",
                      "comparator",
                      "detected",
                      "not_detected",
                      "not_tested",
                      "antennal_active",
                      "antennal_inconsistent",
                      "antennal_inactive",
                      "antennal_not_tested"
                    ]
                  }
                }
              }
            }
          },
          "evidence_classes": {
            "type": "array",
            "description": "the compound's evidence classes (docs/evidence-classes.md) in the taxa of the case's observations: the rows of derived/tables/evidence_classes.tsv, computed over all Atlas records, not only the case's. Contradictions keep both rows",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "taxon_id",
                "evidence_class",
                "n_observations",
                "n_significant",
                "n_tentative",
                "populations",
                "population_match",
                "observation_ids"
              ],
              "properties": {
                "taxon_id": {
                  "type": "string"
                },
                "evidence_class": {
                  "enum": [
                    "female_detected_gland",
                    "female_detected_emission",
                    "female_detected_combined",
                    "female_not_detected",
                    "antennal_active",
                    "antennal_inconsistent",
                    "antennal_inactive",
                    "attractant_alone",
                    "attractive_lure_component",
                    "addition_increased",
                    "addition_decreased",
                    "addition_no_effect",
                    "female_pheromone_component"
                  ]
                },
                "n_observations": {
                  "type": "integer",
                  "minimum": 1
                },
                "n_significant": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "behavioural classes and the derived class only"
                },
                "n_tentative": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "chemistry classes and the derived class only"
                },
                "populations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "population_match": {
                  "enum": [
                    "yes",
                    "no",
                    "unknown",
                    null
                  ],
                  "description": "female_pheromone_component only: whether its chemistry and behaviour share a named population"
                },
                "observation_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "observation_type",
          "taxon",
          "reference",
          "context",
          "evidence",
          "source_location",
          "statement"
        ],
        "properties": {
          "observation_id": {
            "type": "string"
          },
          "observation_type": {
            "enum": [
              "chemical_measurement",
              "behavioural_response",
              "electrophysiology"
            ]
          },
          "taxon": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atlas_id",
              "accepted_name",
              "name_as_reported"
            ],
            "properties": {
              "atlas_id": {
                "type": "string"
              },
              "accepted_name": {
                "type": "string"
              },
              "name_as_reported": {
                "type": "string"
              }
            }
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "atlas_id",
              "citation",
              "doi"
            ],
            "properties": {
              "atlas_id": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              },
              "doi": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "context": {
            "type": "object",
            "description": "the record's context, every field"
          },
          "experiment_id": {
            "type": [
              "string",
              "array",
              "null"
            ]
          },
          "source_location": {
            "type": "string"
          },
          "assay": {
            "type": "string"
          },
          "treatment": {
            "type": "array"
          },
          "comparator": {
            "type": "object"
          },
          "outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "effect",
              "significance",
              "response"
            ],
            "properties": {
              "effect": {
                "type": "string"
              },
              "significance": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "response": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          },
          "materials": {
            "type": "array"
          },
          "components": {
            "type": "array"
          },
          "responses": {
            "type": "array"
          },
          "statement": {
            "type": "string",
            "description": "one line built from the outcome fields: taxon, population and locality, lure and comparator (description included), dose, setup differences, effect, significance, response values and qualifier; or detections, negatives and untested compounds; or antennal readings. A summary: the structured fields and evidence carry the rest"
          },
          "trap": {
            "type": [
              "object",
              "null"
            ]
          },
          "dispenser": {
            "type": [
              "object",
              "null"
            ]
          },
          "dose": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "author_statement",
              "author_statement_form",
              "unresolved",
              "atlas_notes"
            ],
            "properties": {
              "author_statement": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "author_statement_form": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "what the record says its source does not give"
              },
              "atlas_notes": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the Atlas curator's notes and inferences, never the authors'"
              }
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_label",
          "observation_ids",
          "observed_contrast"
        ],
        "properties": {
          "observation_ids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "observed_contrast": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b"
            ],
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              }
            },
            "description": "each side's statement, verbatim from its observation entry; the bundle draws no conclusion"
          },
          "case_label": {
            "type": "string",
            "description": "the case author's neutral name for the pair, not built from records"
          }
        }
      }
    },
    "espmap": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atlas_id",
          "protocol",
          "path",
          "sha256"
        ],
        "properties": {
          "atlas_id": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "computed/espmap/<slug>/<protocol>/ensemble.json"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "case_title": {
      "type": "string",
      "description": "the case author's words, not built from records"
    }
  }
}
